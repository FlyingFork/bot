# Shared across all apps
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/translation_bot?schema=public
LOG_LEVEL=info

# ── apps/bot ──────────────────────────────────────────────────────────
# Copy this block into apps/bot/.env
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
DEV_GUILD_IDS=
BOT_API_PORT=3001
BOT_API_KEY=change-me-to-a-strong-secret

# ── apps/web ──────────────────────────────────────────────────────────
# Copy this block into apps/web/.env
BOT_API_URL=http://localhost:3001
BOT_API_KEY=change-me-to-a-strong-secret
BETTER_AUTH_SECRET=change-me-to-a-strong-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call Better Auth.
# On a VPS, set this to your public app origin, for example:
# BETTER_AUTH_TRUSTED_ORIGINS=https://example.com
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
