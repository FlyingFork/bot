{
  "name": "@tiles-survive/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio --browser none",
    "db:sync-event-names": "node scripts/sync-event-member-names.mjs",
    "db:sync-event-names:apply": "node scripts/sync-event-member-names.mjs --apply"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "prisma": "^7.8.0",
    "dotenv": "^17.3.1",
    "typescript": "^5.6.3"
  }
}
