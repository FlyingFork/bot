{
  "name": "tiles-survive",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "register:global": "npm run register:global --workspace=@tiles-survive/bot",
    "db:generate": "turbo run db:generate --filter=@tiles-survive/database",
    "db:migrate": "turbo run db:migrate --filter=@tiles-survive/database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@tiles-survive/database",
    "db:seed": "turbo run db:seed --filter=@tiles-survive/database",
    "db:studio": "turbo run db:studio --filter=@tiles-survive/database"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
