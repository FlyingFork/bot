# Development / Staging Environment
# Окружение для разработки и staging
#
# EN: Copy this file to .env for local development against the dev database.
#     When setting up the staging VPS, use this as the basis for the
#     DEV_VPS_ENV GitHub secret (update DATABASE_URL and domain values).
#
# RU: Скопируйте этот файл в .env для локальной разработки с dev-базой.
#     При настройке staging VPS используйте этот файл как основу для
#     GitHub-секрета DEV_VPS_ENV (обновите DATABASE_URL и домен).

# ── Shared / Общие ────────────────────────────────────────────────────────────

# Local dev database. On staging VPS, point this to tiles_survive_dev.
# Локальная dev-база. На staging VPS укажите tiles_survive_dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiles_survive_dev

LOG_LEVEL=info

# ── apps/web ──────────────────────────────────────────────────────────────────

# Marks this as a staging build — shows the banner and [DEV] title prefix.
# Помечает сборку как staging — показывает баннер и префикс [DEV] в заголовке.
NEXT_PUBLIC_APP_ENV=staging

# URL of the bot's internal HTTP API.
# URL внутреннего HTTP API бота.
BOT_API_URL=http://localhost:3001

# Shared secret between the web app and the bot. Must match BOT_API_KEY below.
# Общий секрет между веб-приложением и ботом. Должен совпадать с BOT_API_KEY ниже.
BOT_API_KEY=change-me-to-a-strong-secret

# Better Auth — authentication library configuration.
# Better Auth — настройка библиотеки аутентификации.
BETTER_AUTH_SECRET=change-me-to-a-strong-secret-min-32-chars

# For local dev, use http://localhost:3000.
# For staging VPS, use your staging domain: https://dev.yourdomain.com
# Для локальной разработки: http://localhost:3000
# Для staging VPS: https://dev.yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed origins for auth callbacks.
# For local dev: http://localhost:3000
# For staging VPS: https://dev.yourdomain.com
# Список разрешённых origin для auth-коллбэков (через запятую).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ── apps/bot ──────────────────────────────────────────────────────────────────
#
# The develop branch does NOT deploy a separate bot instance.
# The staging web app calls the PRODUCTION bot's API (BOT_API_URL above).
# Fill these in only if you are running the bot locally alongside the web app.
#
# Ветка develop НЕ деплоит отдельный экземпляр бота.
# Staging веб-приложение обращается к API ПРОДАКШН-бота (BOT_API_URL выше).
# Заполните эти переменные только если запускаете бота локально вместе с веб.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Self-hosted LibreTranslate instance URL.
# URL самостоятельно развёрнутого экземпляра LibreTranslate.
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# Comma-separated Discord guild IDs for registering slash commands during development.
# ID серверов Discord через запятую — для регистрации slash-команд в dev-режиме.
DEV_GUILD_IDS=

BOT_API_PORT=3001
